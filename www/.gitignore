# Node / Astro — ignore build output and deps
node_modules/
.astro/
dev-dist/

# Netlify CLI state
.netlify/

# Re-include the CMS API client source dir, which the repo-root Python-template
# `lib/` rule would otherwise swallow (it's meant for Python build artifacts).
!src/lib/
!src/lib/**
dist-fresh/

# dist/ is committed: it's what the Cloudflare deploy workflow ships (the build
# needs the local CMS, so CI can't produce it). The root .gitignore ignores
# dist/ for the Python side, so re-include it here.
!dist/
